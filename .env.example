# ==============================================================================
# Copper Kitchen — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# ==============================================================================

# --- Database (PostgreSQL 15, see docker-compose.yml) -------------------------
DATABASE_URL="postgresql://copper:copper@localhost:5432/copperkitchen?schema=public"

# --- Auth (JWT) ----------------------------------------------------------------
# Generate a strong random secret, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-secret"

# Default admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# --- SMTP (outbound email) ------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user@example.com"
SMTP_PASSWORD="smtp-password"
# Verified contact address for Copper Kitchen. NOTE: no verified Copper Kitchen
# email exists — configure this to whichever address the operator controls.
RESTAURANT_EMAIL="hello@example.com"

# --- URLs ------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# --- reCAPTCHA ---------------------------------------------------------------------
RECAPTCHA_SECRET=""

# --- Runtime ------------------------------------------------------------------------
NODE_ENV="development"
